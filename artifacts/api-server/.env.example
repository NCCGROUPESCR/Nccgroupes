# Copy relevant values into Render's Environment settings for this service.
# On Replit these are already provided by the workspace (secrets + userenv).

NODE_ENV=production
PORT=8080

# Postgres connection string. Render Postgres provides this directly.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Managed Postgres (Render, Supabase, etc.) requires SSL with an untrusted
# local CA — leave this on in production. Set to "false" for a local/plain
# Postgres that doesn't use SSL. Named PGSSL, not DATABASE_SSL, because
# Render reserves the DATABASE_ prefix for its linked-database variables.
PGSSL=true

# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://your-frontend.example.com,https://your-other-frontend.example.com
CORS_ORIGIN=https://your-frontend.onrender.com

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Optional — payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional — used to build absolute links (e.g. in emails/webhooks)
APP_BASE_URL=https://your-api.onrender.com

# Optional — set to "true" temporarily to load demo accounts/transactions on
# boot (useful on free-tier hosts with no shell access). Safe to leave on:
# the seed script checks for existing demo data and skips if already present.
# Turn back off once you've seeded, or leave it — it's a no-op after the first run.
SEED_ON_BOOT=false
